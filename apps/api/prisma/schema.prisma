// Prisma schema của Evolve Web.
// Bám theo contract trong packages/shared (type User, Project, Issue, Label).
// Chỉ B sửa file này và tạo migration (xem docs/EVOLVE_WEB_TEAM_WORKFLOW.vi.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum Priority {
  NO_PRIORITY
  URGENT
  HIGH
  MEDIUM
  LOW
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  /// Mật khẩu đã băm bằng bcrypt. Không bao giờ trả về qua API.
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  projects       Project[]
  assignedIssues Issue[]

  @@map("users")
}

model Project {
  id           String   @id @default(cuid())
  name         String
  /// Tiền tố identifier, ví dụ "EVO" → "EVO-12". Duy nhất trong phạm vi một chủ sở hữu.
  key          String
  icon         String?
  color        String   @default("#E8B07C")
  /// Số thứ tự của issue gần nhất; tăng 1 mỗi khi tạo issue để sinh identifier.
  issueCounter Int      @default(0) @map("issue_counter")
  ownerId      String   @map("owner_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  issues Issue[]

  @@unique([ownerId, key])
  @@index([ownerId])
  @@map("projects")
}

model Issue {
  id          String   @id @default(cuid())
  /// Số thứ tự trong project (12 trong "EVO-12").
  number      Int
  /// Lưu sẵn "<key>-<number>" để tìm kiếm và hiển thị nhanh.
  identifier  String
  title       String
  description String?
  status      Status   @default(BACKLOG)
  priority    Priority @default(NO_PRIORITY)
  /// Chuỗi lexorank: thứ tự trong cùng một cột trạng thái.
  rank        String
  projectId   String   @map("project_id")
  assigneeId  String?  @map("assignee_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  labels   IssueLabel[]

  @@unique([projectId, number])
  @@index([projectId, status, rank])
  @@index([assigneeId])
  @@map("issues")
}

model Label {
  id    String @id @default(cuid())
  name  String @unique
  /// Mã màu hex.
  color String

  issues IssueLabel[]

  @@map("labels")
}

model IssueLabel {
  issueId String @map("issue_id")
  labelId String @map("label_id")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
  @@map("issue_labels")
}
