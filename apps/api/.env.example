# Biến môi trường cho apps/api. Copy thành .env:  cp .env.example .env
# KHÔNG commit file .env

DATABASE_URL=postgresql://evolve:evolve@localhost:5432/evolve?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=4000
# Nhiều địa chỉ thì ngăn cách bằng dấu phẩy
CORS_ORIGIN=http://localhost:3000
