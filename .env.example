# Biến cho docker-compose.yml (PostgreSQL ở local).
# Copy thành .env ở thư mục gốc nếu muốn đổi giá trị mặc định: cp .env.example .env
POSTGRES_USER=evolve
POSTGRES_PASSWORD=evolve
POSTGRES_DB=evolve
POSTGRES_PORT=5432

# --- apps/api/.env (B tạo apps/api/.env.example ở W1-B2) ---
# DATABASE_URL=postgresql://evolve:evolve@localhost:5432/evolve?schema=public
# JWT_SECRET=change-me
# JWT_EXPIRES_IN=7d
# PORT=4000
# CORS_ORIGIN=http://localhost:3000

# --- apps/web/.env.local (C tạo apps/web/.env.example ở W1-C1) ---
# NEXT_PUBLIC_API_URL=http://localhost:4000
